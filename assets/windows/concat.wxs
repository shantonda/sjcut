<?xml version="1.0" encoding="UTF-8"?>
<!--
  SJCut's Windows Installer package, the .msi beside the Inno Setup .exe.

  Built by build-app.yml with WiX from the staged folder the .exe is made
  of, so the two installers ship the same files. The .exe is the
  one a person double-clicks; this is the one an administrator deploys -
  Group Policy, Intune, winget - and it installs for the machine, into
  Program Files, with a Start menu entry and a clean uninstall. Handed in:

    wix build -arch x64 -d Version=0.2.9 -d Root=C:\...\SJCut
              -d Stage=C:\...\stage\SJCut-0.2.9-windows-x86_64
              -o stage\SJCut-0.2.9-windows-x86_64.msi assets\windows\concat.wxs

  Root is the repository: WiX resolves a source path against where it is
  run from, not against this file.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- One upgrade code for the life of the product, so a newer .msi
       replaces an older one rather than sitting beside it. -->
  <Package Name="SJCut"
           Manufacturer="SJCut Contributors"
           Version="$(var.Version)"
           UpgradeCode="6C4D5D8E-9B2A-4F3B-8E1C-5A7D2B9F0C11"
           Scope="perMachine"
           Language="1033">
    <MajorUpgrade DowngradeErrorMessage="A newer version of SJCut is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="concat.ico" SourceFile="$(var.Root)\assets\icons\concat.ico" />
    <Property Id="ARPPRODUCTICON" Value="concat.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/shantonda/sjcut" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SJCut" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="SJCut" />
    </StandardDirectory>

    <Feature Id="Main" Title="SJCut" Level="1">
      <ComponentGroupRef Id="Program" />
      <ComponentRef Id="StartMenu" />
    </Feature>

    <!-- Every file in the staged folder, as it is there. -->
    <ComponentGroup Id="Program" Directory="INSTALLFOLDER">
      <Files Include="$(var.Stage)\**" />
    </ComponentGroup>

    <Component Id="StartMenu" Directory="ShortcutFolder" Guid="2F0B7C51-6E4D-4A1B-9C3E-8D5F1A2B3C44">
      <Shortcut Id="StartMenuShortcut"
                Name="SJCut"
                Description="Video editor"
                Target="[INSTALLFOLDER]concat.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="concat.ico" />
      <!-- The way in when a graphics driver draws the window as coloured
           squares: it turns off Settings > General > Draw on the GPU,
           which that window hides. -->
      <Shortcut Id="SafeGraphicsShortcut"
                Name="SJCut (safe graphics)"
                Description="SJCut, drawn in software"
                Target="[INSTALLFOLDER]concat.exe"
                Arguments="--software"
                WorkingDirectory="INSTALLFOLDER"
                Icon="concat.ico" />
      <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\SJCut" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
